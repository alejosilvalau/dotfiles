#!/bin/bash

if [ -z "$1" ]; then
  echo "Error: A file name must be set, e.g. on \"the wonderful thing about tiggers\"."
  exit 1
fi

file_name=$(echo "$1" | tr ' ' '-')
formatted_file_name=NOTE_$(date "+%Y%m%d")_${file_name}.md
cd "$HOME/Desktop/vault-desktop" || exit
touch "${formatted_file_name}"
nvim "${formatted_file_name}"
