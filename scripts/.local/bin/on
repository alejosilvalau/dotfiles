#!/bin/bash

if [ -z "$1" ]; then
  echo "Error: A file name must be set, e.g. on \"the wonderful thing about tiggers\"."
  exit 1
fi

file_name=NOTE_$(date "+%Y%m%d")_$(echo "$1" | tr ' ' '-').md
vault_path="$HOME/Desktop/vault-desktop"
cd "$vault_path" || exit
touch "${file_name}"

# Create session detached if it doesn't exist yet
tmux new-session -d -s "vault-desktop" -c "$vault_path" 2>/dev/null

# Now send nvim command before attaching
tmux send-keys -t "vault-desktop" "nvim $vault_path/${file_name}" C-m

# Finally attach
tmux attach-session -t "vault-desktop"
